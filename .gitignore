# ==========================================
# ContribHub Project .gitignore
# ==========================================

# Internal Project Plan (Keep locally, do not push)
ContribHub_Project_Plan.md

# Environment variables & secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production builds
dist/
dist-ssr/
frontend/dist/
build/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary / scratch files
scratch/
.system_generated/
