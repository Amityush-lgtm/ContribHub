# ==========================================
# ContribHub Backend Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local:  mongodb://localhost:27017/contribhub
# For Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/contribhub
# Leave empty to use the built-in in-memory MongoDB for quick development
MONGODB_URI=

# JWT Authentication
# IMPORTANT: Change this to a strong random string in production!
JWT_SECRET=change_this_to_a_secure_secret_key
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS in development)
CLIENT_URL=http://localhost:5173

# Seed database on startup (set to "true" only for initial demo data setup)
SEED_ON_START=false

# GitHub Integration (Optional - increases rate limit for syncing contributions from 60/hr to 5,000/hr)
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
